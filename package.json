{
  "name": "fretium",
  "version": "0.0.0",
  "description": "Fretboard diagram generator",
  "keywords": [
    "fretboard",
    "diagram",
    "generator",
    "guitar",
    "bass",
    "ukulele",
    "chords",
    "scales"
  ],
  "homepage": "https://fretium.cuesta.dev",
  "bugs": "https://github.com/alvaro-cuesta/fretium/issues",
  "author": {
    "name": "Álvaro Cuesta",
    "url": "https://alvaro.cuesta.dev"
  },
  "license": "GPL-3.0-only",
  "repository": "github:alvaro-cuesta/fretium",
  "private": true,
  "type": "module",
  "config": {
    "name": "Fretium",
    "shortName": "Fretium",
    "description": "Fretboard diagram generator",
    "themeColor": "#bc366a",
    "url": "https://fretium.cuesta.dev",
    "publicUrlBase": "https://fretium.cuesta.dev",
    "repositoryUrl": "https://www.github.com/alvaro-cuesta/fretium"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "pnpm run lint:tsc",
    "clean": "rm -rf build dist",
    "clean:hard": "rm -rf build dist node_modules/.tmp/tsconfig.*.tsbuildinfo",
    "preview": "vite preview",
    "lint:tsc": "tsc --build",
    "lint:eslint": "eslint .",
    "lint:knip": "knip",
    "lint:madge": "madge --warning --circular --extensions .js,.jsx,.ts,.tsx ./src/main.tsx",
    "lint:prettier": "prettier --check .",
    "test": "vitest --typecheck",
    "debug:visualize-build": "vite-bundle-visualizer",
    "generate:pwa-assets": "pwa-assets-generator",
    "generate:og-assets": "node ./bin/generate-og-assets.ts"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-dom": "^3.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^3.0.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "knip": "^5.88.1",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass-embedded": "^1.98.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "type-fest": "^5.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-css-modules": "^1.14.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
